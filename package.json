{
  "name": "starorbit",
  "version": "1.0.71",
  "private": true,
  "description": "StarOrbit — Explore spacecraft, Earth, the Solar System and Chinese sky culture in your browser.",
  "author": "Wenshuishi",
  "license": "CC-BY-NC-4.0",
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "esbuild": "0.25.11",
    "geotiff": "3.0.5",
    "satellite.js": "6.0.2",
    "three": "0.180.0",
    "three-mesh-bvh": "0.9.2"
  },
  "type": "module",
  "scripts": {
    "build": "node build.mjs && node build.mjs --local",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "setup:python": "python3 -m venv .venv && .venv/bin/python -m pip install -r scripts/cloud-requirements.txt",
    "build:web": "node build.mjs --web",
    "build:local": "node build.mjs --local",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tests/**/*.{js,mjs}\" \"scripts/**/*.mjs\" build.mjs eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tests/**/*.{js,mjs}\" \"scripts/**/*.mjs\" build.mjs eslint.config.js",
    "test:docs": "python3 scripts/check-docs.py && node tests/docs-examples.mjs && python3 tests/documentation.py"
  },
  "displayVersion": "1.71",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.6.2"
  }
}
